{
  "name": "markflow",
  "version": "0.10.0",
  "description": "A minimalist Chrome sidepanel extension and web app for capturing web content as Markdown",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:extension": "pnpm --filter @markflow/extension dev",
    "dev:web": "pnpm --filter @markflow/web dev",
    "dev:server": "pnpm --filter @markflow/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @markflow/extension test:e2e"
  },
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
